<MenuConf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="schema.xsd">
	<!-- Used when backgroundLayer=wms. GEBCO archive host is gone; use public MapServer demo. -->
	<BackgroundLayers server="https://demo.mapserver.org/cgi-bin/wms"
				BBOX="-180,-90,180,90"
				proj="EPSG:4326"
				format="image/png">
		<layer name="continents" featureInfo="none"/>
	</BackgroundLayers>
</MenuConf>
